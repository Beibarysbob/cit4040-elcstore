digraph ER {
graph [rankdir=LR, layout=dot, splines=polyline, nodesep=0.3, ranksep=0.8, bgcolor="white"];
node [shape=box,style="filled,rounded",fontname="Arial",fontsize=11,color="#64748b"];
edge [color="#94a3b8",arrowsize=0.6];
"users" [fillcolor="#dbeafe"];
"addresses" [fillcolor="#dbeafe"];
"brands" [fillcolor="#dcfce7"];
"categories" [fillcolor="#dcfce7"];
"products" [fillcolor="#dcfce7"];
"product_variants" [fillcolor="#dcfce7"];
"product_images" [fillcolor="#dcfce7"];
"product_specifications" [fillcolor="#dcfce7"];
"reviews" [fillcolor="#fef3c7"];
"carts" [fillcolor="#f3e8ff"];
"cart_items" [fillcolor="#f3e8ff"];
"wishlists" [fillcolor="#f3e8ff"];
"shop_orders" [fillcolor="#fee2e2"];
"order_items" [fillcolor="#fee2e2"];
"payments" [fillcolor="#fee2e2"];
"delivery_options" [fillcolor="#fee2e2"];
"promo_codes" [fillcolor="#ffe4e6"];
"promo_code_usages" [fillcolor="#ffe4e6"];
"refresh_tokens" [fillcolor="#e0f2fe"];
"users" -> "addresses";
"users" -> "carts";
"users" -> "wishlists";
"users" -> "reviews";
"users" -> "shop_orders";
"users" -> "promo_code_usages";
"users" -> "refresh_tokens";
"categories" -> "products";
"categories" -> "categories";
"brands" -> "products";
"products" -> "product_variants";
"products" -> "product_images";
"products" -> "product_specifications";
"products" -> "reviews";
"products" -> "cart_items";
"products" -> "wishlists";
"products" -> "order_items";
"product_variants" -> "cart_items";
"product_variants" -> "order_items";
"carts" -> "cart_items";
"shop_orders" -> "order_items";
"shop_orders" -> "payments";
"shop_orders" -> "promo_code_usages";
"promo_codes" -> "promo_code_usages";
"promo_codes" -> "categories" [style=dashed,label="applicable"] ;
"promo_codes" -> "products" [style=dashed,label="applicable"] ;
}
